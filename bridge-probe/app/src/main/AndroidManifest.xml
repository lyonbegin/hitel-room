<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.samsung.android.callassistant"/>
        <package android:name="com.samsung.android.incallui"/>
        <package android:name="com.samsung.android.dialer"/>
    </queries>
    <uses-permission android:name="com.samsung.android.callassistant.permission.TEXT_CALL"/>
    <uses-permission android:name="com.samsung.android.callassistant.permission.VOIP_TRANSLATOR"/>
    <uses-permission android:name="com.samsung.android.incall.permission.READ_CALL_CONTENT_PROVIDER"/>
    <uses-permission android:name="com.samsung.android.incall.permission.WRITE_CALL_CONTENT_PROVIDER"/>
    <application android:label="Samsung Bridge Probe" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
